NEXT_PUBLIC_ADMIN_PASSWORD=admin123
NEXT_PUBLIC_WELCOME_PASSCODE=welcomecrt
NEXT_PUBLIC_MEDICAL_PASSCODE=medicalcrt

# Supabase connection string (Settings -> Database -> Connection string -> "Transaction pooler").
# Using the pooler (port 6543) is important for serverless deployments (Vercel) so each
# function invocation doesn't open its own direct Postgres connection.
DATABASE_URL=postgresql://postgres.xxxxxxxx:your-password@aws-0-region.pooler.supabase.com:6543/postgres
